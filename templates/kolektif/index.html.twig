{% extends 'base.html.twig' %}
{% block title %}Daftar Batch — Zeran Parcel{% endblock %}

{% block stylesheets %}
<style>
    .kolektif { max-width: 1600px; margin: 0 auto; }
    .kolektif-filter-card { background: var(--bg-sub); border: 1px solid var(--border); border-radius: var(--radius); }
    .kolektif-filter-header { padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .kolektif-filter-title { font-size: var(--fs-base); font-weight: 600; color: var(--text); }
    .kolektif-filter-body { padding: 16px; }
    .kolektif-stat { background: var(--bg-sub); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; position: relative; overflow: hidden; }
    .kolektif-stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
    .kolektif-stat.s-blue::before { background: var(--info); }
    .kolektif-stat.s-green::before { background: var(--success); }
    .kolektif-stat.s-accent::before { background: var(--accent); }
    .kolektif-stat .stat-label { font-size: var(--fs-xs); font-weight: 600; color: var(--text-3); margin-bottom: 6px; }
    .kolektif-stat .stat-val { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: var(--text); line-height: 1.2; letter-spacing: -.02em; }
    .kolektif-stat .stat-val.text-success { color: var(--success); }
    .kolektif-table td, .kolektif-table th { vertical-align: middle; }
</style>
{% endblock %}

{% block body %}
<div class="kolektif">
    <div class="page-hd">
        <div class="page-hd-row">
            <div>
                <h1>Daftar Batch</h1>
                <p>
                    {% if isFiltered %}
                        {{ totalItems|number_format(0,',','.') }} batch{% if totalItems > 0 %} — Rp {{ totalSum|number_format(0,',','.') }} — {{ totalMembers|number_format(0,',','.') }} setoran{% endif %}
                    {% else %}
                        Riwayat input setoran kolektif per batch.
                    {% endif %}
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_kolektif_index', {filter:1,tahun:0,bulan:0}) }}" class="btn btn-secondary">Semua Periode</a>
                <a href="{{ path('app_kolektif_input') }}" class="btn btn-primary"><i class="ph ph-plus-circle me-1"></i> Input Baru</a>
            </div>
        </div>
    </div>

    {% if isFiltered and totalItems > 0 %}
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-4">
            <div class="kolektif-stat s-blue">
                <div class="stat-label">Total Batch</div>
                <div class="stat-val">{{ totalItems|number_format(0,',','.') }}</div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="kolektif-stat s-green">
                <div class="stat-label">Total Setoran</div>
                <div class="stat-val text-success">Rp {{ totalSum|number_format(0,',','.') }}</div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="kolektif-stat s-accent">
                <div class="stat-label">Total Anggota</div>
                <div class="stat-val">{{ totalMembers|number_format(0,',','.') }}</div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="kolektif-filter-card mb-3">
        <div class="kolektif-filter-header">
            <div class="kolektif-filter-title">Filter Batch</div>
        </div>
        <div class="kolektif-filter-body">
            <form method="get" action="{{ path('app_kolektif_index') }}" id="filterForm" class="row g-2 align-items-end">
                <input type="hidden" name="filter" value="1">
                <div class="col-6 col-sm-3 col-md-2 col-lg-1">
                    <label class="form-label text-3 fs-xs fw-semibold mb-1">Tahun</label>
                    <select name="tahun" id="tahunSelect" class="form-select form-select-sm">
                        <option value="0" {% if tahun==0 %}selected{% endif %}>Semua</option>
                        {% for y in yearsList %}<option value="{{ y }}" {% if tahun==y %}selected{% endif %}>{{ y }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-md-2 col-lg-2">
                    <label class="form-label text-3 fs-xs fw-semibold mb-1">Bulan</label>
                    <select name="bulan" id="bulanSelect" class="form-select form-select-sm">
                        <option value="0" {% if bulan=='0' or bulan=='' %}selected{% endif %}>Semua</option>
                        {% for mKey,mName in monthsList %}<option value="{{ mKey }}" {% if bulan==mKey %}selected{% endif %}>{{ mName }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <label class="form-label text-3 fs-xs fw-semibold mb-1">Reseller</label>
                    <select name="reseller_id" id="resellerSelect" class="form-select form-select-sm">
                        <option value="0">Semua Reseller</option>
                        {% for r in resellers %}<option value="{{ r.id }}" {% if resellerId==r.id %}selected{% endif %}>{{ r.namaReseller }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-5 col-lg-6">
                    <label class="form-label text-3 fs-xs fw-semibold mb-1">Cari ID batch / reseller</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="ID batch atau nama reseller...">
                        <button type="submit" class="btn btn-primary" title="Cari">
                            <i class="ph ph-magnifying-glass"></i>
                        </button>
                        <a href="{{ path('app_kolektif_index') }}" class="btn btn-secondary" title="Reset filter">
                            <i class="ph ph-x"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        {% if not isFiltered %}
            <div class="empty">
                <i class="ph ph-funnel"></i>
                <div class="empty-title">Data belum ditampilkan</div>
                <div class="empty-sub mb-3">Pilih filter atau tampilkan semua batch.</div>
                <button onclick="document.getElementById('filterForm').submit();" class="btn btn-secondary">Tampilkan semua</button>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="data-table kolektif-table table-hover">
                    <thead>
                        <tr>
                            <th style="width:70px;">Batch</th>
                            <th style="width:95px;">Periode</th>
                            <th>Reseller</th>
                            <th class="text-center" style="width:90px;">Anggota</th>
                            <th class="text-end" style="width:150px;">Total Setoran</th>
                            <th style="width:120px;">Dibuat</th>
                            <th class="text-center" style="width:60px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for b in batches %}
                            <tr class="transition-colors">
                                <td><a href="{{ path('app_kolektif_detail', {id:b.id}) }}" class="badge badge-blue fs-base text-decoration-none">#{{ b.id }}</a></td>
                                <td><span class="badge">{{ b.periode|format_periode }}</span></td>
                                <td>
                                    {% if b.reseller %}
                                        <div class="fw-semibold text-1">{{ b.reseller.namaReseller }}</div>
                                        <div class="fs-xs text-3">{{ b.reseller.kodeReseller }}</div>
                                    {% else %}<span class="text-3">—</span>{% endif %}
                                </td>
                                <td class="text-center"><span class="badge">{{ b.totalRows }}</span></td>
                                <td class="text-end fw-bold text-1 fs-base">Rp {{ b.totalNominal|number_format(0,',','.') }}</td>
                                <td class="fs-sm text-3">
                                    <div><i class="ph ph-clock me-1"></i>{{ b.createdAt|date('d/m/Y H:i') }}</div>
                                    {% if b.createdBy %}
                                        <div class="fs-xs text-muted">oleh <span class="fw-medium text-2">{{ b.createdBy }}</span></div>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a href="{{ path('app_kolektif_detail', {id:b.id}) }}" class="act-btn" title="Detail" aria-label="Lihat detail batch {{ b.id }}"><i class="ph ph-eye" aria-hidden="true"></i></a>
                                        {% if not lockedBatchIds[b.id] %}
                                        <form method="post" action="{{ path('app_kolektif_delete', {id:b.id}) }}" class="d-inline"
                                              data-confirm="Hapus Batch #{{ b.id }}? Seluruh {{ b.totalRows }} transaksi dalam batch ini akan ikut terhapus.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('app_kolektif_delete') }}">
                                            <button type="submit" class="act-btn danger" title="Hapus Batch" aria-label="Hapus batch {{ b.id }}"><i class="ph ph-trash" aria-hidden="true"></i></button>
                                        </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7"><div class="empty py-4"><i class="ph ph-inbox fs-1 text-muted"></i><div class="empty-title mt-2">Tidak ada batch</div><div class="empty-sub">Coba ubah filter.</div></div></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if totalPages > 1 %}
                <div class="pager">
                    <span class="pager-text">Hal. {{ currentPage }} / {{ totalPages }}, {{ totalItems|number_format(0,',','.') }} batch</span>
                    <div class="pager-links">
                        {% if currentPage > 1 %}<a href="{{ path('app_kolektif_index', {filter:1,tahun:tahun,bulan:bulan,reseller_id:resellerId,q:q,page:currentPage-1}) }}"><i class="ph ph-caret-left"></i></a>{% else %}<span><i class="ph ph-caret-left"></i></span>{% endif %}
                        {% for p in max(1,currentPage-2)..min(totalPages,currentPage+2) %}<a href="{{ path('app_kolektif_index', {filter:1,tahun:tahun,bulan:bulan,reseller_id:resellerId,q:q,page:p}) }}" {% if p==currentPage %}class="active"{% endif %}>{{ p }}</a>{% endfor %}
                        {% if currentPage < totalPages %}<a href="{{ path('app_kolektif_index', {filter:1,tahun:tahun,bulan:bulan,reseller_id:resellerId,q:q,page:currentPage+1}) }}"><i class="ph ph-caret-right"></i></a>{% else %}<span><i class="ph ph-caret-right"></i></span>{% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('filterForm');
    ['tahunSelect','bulanSelect','resellerSelect'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', () => form.submit());
    });
});
</script>
{% endblock %}
