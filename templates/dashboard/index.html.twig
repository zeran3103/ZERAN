                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{% if monthlyTrend|length %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const canvas = document.getElementById('trendChart');
    if (!canvas || typeof Chart === 'undefined') return;

    const allPoints = {{ monthlyTrend|json_encode|raw }};
    const totalTarget = {{ totalTarget|json_encode|raw }} || 0;
    let currentPeriod = 12;

    const colors = () => {
        const cs = getComputedStyle(document.documentElement);
        const read = name => cs.getPropertyValue(name).trim();
        return { grid: read('--border'), text: read('--text-3'), accent: read('--accent'), success: read('--success') };
    };

    const fmtShort = (v) => {
        if (v >= 1000000000) return (v / 1000000000).toFixed(1).replace('.0', '') + ' M';
        if (v >= 1000000) return (v / 1000000).toFixed(1).replace('.0', '') + ' jt';
        if (v >= 1000) return (v / 1000).toFixed(0) + ' rb';
        return v.toLocaleString('id-ID');
    };

    const fmtRp = (v) => 'Rp ' + (v || 0).toLocaleString('id-ID');

    function calcStats(points) {
        const totals = points.map(p => Number(p.total || 0));
        const total = totals.reduce((a, b) => a + b, 0);
        const avg = totals.length > 0 ? total / totals.length : 0;
        const best = totals.length > 0 ? Math.max(...totals) : 0;
        const worst = totals.length > 0 ? Math.min(...totals) : 0;
        return { total, avg: Math.round(avg), best, worst, monthlyTarget: points.length > 0 ? totalTarget / points.length : 0 };
    }

    function updateStatsDisplay(stats) {
        document.getElementById('statTotal').textContent = fmtRp(stats.total);
        document.getElementById('statAvg').textContent = fmtRp(stats.avg);
        document.getElementById('statBest').textContent = fmtRp(stats.best);
        document.getElementById('statWorst').textContent = fmtRp(stats.worst);
    }

    function sliceData(period) {
        if (period === 'all') return allPoints.slice();
        const n = parseInt(period);
        return allPoints.length > n ? allPoints.slice(-n) : allPoints.slice();
    }

    const ctx = canvas.getContext('2d');
    const c = colors();
    const gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, c.accent);
    gradient.addColorStop(1, c.accent + '66');

    const initPoints = sliceData(12);
    const initStats = calcStats(initPoints);
    updateStatsDisplay(initStats);

    const chart = new Chart(canvas, {
        type: 'bar',
        data: {
            labels: initPoints.map(p => p.bulan || ''),
            datasets: [
                {
                    label: 'Total Setoran',
                    data: initPoints.map(p => Number(p.total || 0)),
                    backgroundColor: gradient,
                    borderRadius: 8,
                    borderSkipped: false,
                    maxBarThickness: 42,
                    order: 2,
                },
                {
                    label: 'Target/bulan',
                    data: initPoints.map(() => initStats.monthlyTarget),
                    type: 'line',
                    borderColor: c.success,
                    borderDash: [6, 4],
                    borderWidth: 2,
                    pointRadius: 0,
                    pointHoverRadius: 4,
                    fill: false,
                    yAxisID: 'y',
                    order: 1,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const val = context.parsed.y;
                            return context.dataset.label + ': ' + fmtRp(val);
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: c.text, maxRotation: 45, minRotation: 0 }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: c.grid },
                    ticks: { color: c.text, callback: value => fmtShort(value) }
                }
            }
        }
    });

    function updateChart(period) {
        const points = sliceData(period);
        const stats = calcStats(points);
        const newGradient = ctx.createLinearGradient(0, 0, 0, canvas.parentElement.clientHeight || 300);
        const ac = colors().accent;
        newGradient.addColorStop(0, ac);
        newGradient.addColorStop(1, ac + '66');

        chart.data.labels = points.map(p => p.bulan || '');
        chart.data.datasets[0].data = points.map(p => Number(p.total || 0));
        chart.data.datasets[0].backgroundColor = newGradient;
        chart.data.datasets[1].data = points.map(() => stats.monthlyTarget);
        chart.data.datasets[1].borderColor = colors().success;
        chart.options.scales.x.ticks.color = colors().text;
        chart.options.scales.y.ticks.color = colors().text;
        chart.options.scales.y.grid.color = colors().grid;
        chart.update();
        updateStatsDisplay(stats);
    }

    document.querySelectorAll('.chart-period-toggle button').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.chart-period-toggle button').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentPeriod = this.dataset.period;
            updateChart(currentPeriod);
        });
    });

    new MutationObserver(() => {
        const theme = colors();
        const g = ctx.createLinearGradient(0, 0, 0, canvas.parentElement.clientHeight || 300);
        g.addColorStop(0, theme.accent);
        g.addColorStop(1, theme.accent + '66');
        chart.data.datasets[0].backgroundColor = g;
        chart.data.datasets[1].borderColor = theme.success;
        chart.options.scales.x.ticks.color = theme.text;
        chart.options.scales.y.ticks.color = theme.text;
        chart.options.scales.y.grid.color = theme.grid;
        chart.update('none');
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
});
</script>
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var cards = document.querySelectorAll('.dashboard-stat');
    cards.forEach(function (card) {
        var isHovered = false;
        card.addEventListener('mouseenter', function () { isHovered = true; });
        card.addEventListener('mousemove', function (e) {
            if (!isHovered) return;
            var r = card.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width - 0.5;
            var y = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform = 'perspective(1000px) translateY(-6px) rotateX(' + (-y * 10).toFixed(2) + 'deg) rotateY(' + (x * 10).toFixed(2) + 'deg) translateZ(8px)';
        });
        card.addEventListener('mouseleave', function () {
            isHovered = false;
            card.style.transform = '';
        });
    });
});
</script>
{% endblock %}
