                                    <td><span class="small text-truncate d-inline-block" style="max-width:130px;">{{ tg.nama_kategori ?: '—' }}</span></td>
                                    <td class="text-end text-danger fw-bold">Rp {{ tg.sisa|number_format(0, ',', '.') }}</td>
                                    <td class="text-center"><span class="badge badge-amber"><i class="ph ph-hourglass me-1" aria-hidden="true"></i>Belum Lunas</span></td>
                                    <td class="text-center">
                                        <a href="{{ path('app_anggota_detail', {id: tg.id}) }}" class="btn btn-xs btn-secondary" title="Detail Anggota">
                                            <i class="ph ph-arrow-square-out me-1" aria-hidden="true"></i> Detail
                                        </a>
